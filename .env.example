# Copia este archivo a .env (en la misma carpeta que docker-compose.yml)
# y reemplaza los valores. NUNCA subas el .env real al repositorio.

DB_USER=app_maternidad
DB_PASSWORD=cambia_esto_por_una_clave_fuerte

JWT_SECRET=genera_una_clave_larga_y_aleatoria

# Dominio real donde sirves el frontend (usado por CORS en el backend)
CORS_ORIGINS=https://tudominio.com
