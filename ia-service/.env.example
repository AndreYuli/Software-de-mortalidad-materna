# Plantilla de configuración de ia-service. Copia este archivo a ia-service/.env
# y completa los valores. NUNCA subas el .env real al repositorio (está en .gitignore).

# --- Proveedor externo compatible con OpenAI (producción: Groq, plan gratuito; ver DEC-005) ---
# Si LLM_BASE_URL tiene valor, /chat y /generar-narrativa usan {LLM_BASE_URL}/chat/completions.
LLM_BASE_URL=https://api.groq.com/openai/v1
# API key del proveedor. Escríbela solo en el .env real (en el servidor, sin eco). Nunca aquí.
LLM_API_KEY=
# Id del modelo. Se llama OLLAMA_MODEL por razones históricas, pero también aplica al proveedor externo.
OLLAMA_MODEL=openai/gpt-oss-20b

# --- Desarrollo local con Ollama ---
# Deja LLM_BASE_URL vacío (LLM_BASE_URL=) para usar Ollama en vez del proveedor externo.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5

# Timeout en segundos de /generar-narrativa (el de /chat está fijo en 120 s en el código).
# OLLAMA_TIMEOUT_S=120
